# ============================================
# Translation provider configuration
# ============================================

# Supported values:
# - mock
# - openai_compatible
TRANSLATION_PROVIDER=mock

# Model name used by the translation endpoint
TRANSLATION_MODEL=gpt-4.1

# OpenAI-compatible endpoint
# Example:
# OPENAI_COMPATIBLE_API_URL=https://api.openai.com/v1/chat/completions
OPENAI_COMPATIBLE_API_URL=

# API key for the OpenAI-compatible endpoint
OPENAI_COMPATIBLE_API_KEY=


# ============================================
# GitHub export configuration
# ============================================

# Absolute path to the local git repository
# Example:
# GITHUB_EXPORT_REPO_PATH=/Users/your_user/projects/my-translation-repo
GITHUB_EXPORT_REPO_PATH=

# Target branch for export
GITHUB_EXPORT_BRANCH=main

# Target directory inside the repository
# Example:
# GITHUB_EXPORT_TARGET_DIR=translated-books
GITHUB_EXPORT_TARGET_DIR=.

# Commit message override
# If empty, the export script generates one automatically
GITHUB_EXPORT_COMMIT_MSG=

# Whether to push after commit
# true | false
GITHUB_EXPORT_PUSH=true
